{
  "$ref": "#/definitions/PlacesFile",
  "definitions": {
    "PlacesFile": {
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "default": "2026-10-18T13:07:41.427Z"
        },
        "home": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "address": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "lat",
            "lng"
          ],
          "additionalProperties": false
        },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "enum": [
                  "sightseeing",
                  "food",
                  "lodging",
                  "transport",
                  "other"
                ],
                "default": "sightseeing"
              },
              "area": {
                "type": "string"
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "address": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "memo": {
                "type": "string"
              },
              "visits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "tripId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "default": []
              },
              "rating": {
                "type": "number",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
